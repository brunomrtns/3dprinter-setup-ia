# Fábrica 3D — Variáveis de Ambiente (TEMPLATE PÚBLICO — ZERO SEGREDOS)
# Copie para .env (fora do git, chmod 600) na VPS (/opt/fab3d/.env)

# Postgres dedicado (fab3d-postgres)
POSTGRES_USER=fab3d
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fab3d
DATABASE_URL=postgresql://fab3d:CHANGE_ME_STRONG_PASSWORD@fab3d-postgres:5432/fab3d

# Redis dedicado (fab3d-redis)
REDIS_HOST=fab3d-redis
REDIS_PORT=6379

# MinIO dedicado (fab3d-minio)
MINIO_ENDPOINT=fab3d-minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=fab3dadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=fab3d
PUBLIC_BASE_URL=https://brunointegrations.com/fab3d

# Auth JWT + Conta única do dono (seed)
JWT_SECRET=CHANGE_ME_JWT_SECRET_HEX
ADMIN_EMAIL=bruno@brunointegrations.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_NAME=Bruno

# Worker local (PC do dono)
WORKER_TOKEN=CHANGE_ME_WORKER_TOKEN_HEX
JOB_LEASE_MINUTES=30
