# Fábrica 3D — Worker Local (TEMPLATE PÚBLICO — ZERO SEGREDOS)
# Copie para factory/worker/.env (fora do git, chmod 600)

VPS_URL=https://brunointegrations.com
WORKER_TOKEN=CHANGE_ME_SAME_AS_VPS_WORKER_TOKEN
WORKER_ID=local-rtx3060-12gb
POLL_INTERVAL_SEC=10

# M5 — Assistente de Imagem (default: limpeza local rembg; externo OFF sem chave)
EXTERNAL_IMAGE_ENHANCE=false
IMAGE_PROVIDER=mock
# GEMINI_API_KEY=

# M6 — Agente de Edição (default: mock determinístico; GLM real = ligar abaixo)
AGENT_PROVIDER=mock
# ZAI_API_KEY=
# ZAI_MODEL=glm-4.5
